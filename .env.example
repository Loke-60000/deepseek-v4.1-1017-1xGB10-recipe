# Settings for ~/.config/dsv41.env (the dsv41 launcher) or .env in a clone. Real environment variables win.

# Hugging Face cache and the recipe's working directory
DSV41_PATHS_HF_CACHE=~/.cache/huggingface/hub
DSV41_PATHS_ROOT=~/models/dsv41-1xgb10

# Model id, extra ids and port of the API
DSV41_SERVE_MODEL_ID=deepseek-v4.1-flash
DSV41_SERVE_ALIASES=
DSV41_SERVE_PORT=8888

# Second model id that answers as the derisked variant (empty: off)
DSV41_SERVE_ABLATE_MODEL=

# Engine settings from config/profiles can be overridden here, for example:
# TF_DSV41_SLOTS=4
# TF_DSV41_TRACE_TOKENS=/state/tokens.jsonl   # log served tokens, to train a draft model later
