# Copy to .env (untracked) and set what differs on this machine. Real environment variables win over .env.

# Where the Hugging Face cache and the recipe's working data live
DSV41_PATHS_HF_CACHE=~/.cache/huggingface/hub
DSV41_PATHS_ROOT=~/models/dsv41-1xgb10

# Served model id, extra ids, port
DSV41_SERVE_MODEL_ID=deepseek-v4.1-flash
DSV41_SERVE_ALIASES=
DSV41_SERVE_PORT=8888

# Any engine knob from config/profiles overrides the profile, e.g.
# TF_DSV41_SLOTS=4
