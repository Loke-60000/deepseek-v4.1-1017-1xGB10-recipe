diff --git a/zig/src/families/deepseek_v41/cold.zig b/zig/src/families/deepseek_v41/cold.zig
new file mode 100644
index 0000000..3ac2056
--- /dev/null
+++ b/zig/src/families/deepseek_v41/cold.zig
@@ -0,0 +1,122 @@
+//! TF_DSV41_COLD=<json>: rarely routed experts left in their prepared file and read by the GPU through a read-only
+//! mapping (GB10's GPU walks the host page tables, ATS), the rest uploaded compacted. The page cache holds the cold
+//! pages; under memory pressure the kernel may drop them and the next read comes from NVMe.
+//! The set is `{"layers.<i>": [expert, ...]}`, backbone layers only; DSpark's experts stay resident.
+
+const std = @import("std");
+const cuda = @import("cuda");
+const exl3 = @import("exl3.zig");
+
+pub const Set = struct {
+    arena: std.heap.ArenaAllocator,
+    layers: std.AutoHashMapUnmanaged(u32, []const u32) = .empty,
+
+    /// The set TF_DSV41_COLD names, or null when unset.
+    pub fn fromEnv(gpa: std.mem.Allocator, io: std.Io) !?Set {
+        const path = std.mem.trim(u8, std.mem.span(std.c.getenv("TF_DSV41_COLD") orelse return null), " ");
+        if (path.len == 0) return null;
+        var s: Set = .{ .arena = .init(gpa) };
+        errdefer s.arena.deinit();
+        const a = s.arena.allocator();
+        try s.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 24)));
+        return s;
+    }
+
+    fn parse(s: *Set, a: std.mem.Allocator, text: []const u8) !void {
+        const root = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+        if (root != .object) return error.BadColdSet;
+        var it = root.object.iterator();
+        while (it.next()) |e| {
+            if (!std.mem.startsWith(u8, e.key_ptr.*, "layers.") or e.value_ptr.* != .array) return error.BadColdSet;
+            const layer = try std.fmt.parseInt(u32, e.key_ptr.*["layers.".len..], 10);
+            const ids = try a.alloc(u32, e.value_ptr.array.items.len);
+            for (e.value_ptr.array.items, ids) |v, *id| {
+                if (v != .integer or v.integer < 0) return error.BadColdSet;
+                id.* = @intCast(v.integer);
+            }
+            try s.layers.put(a, layer, ids);
+        }
+    }
+
+    pub fn deinit(s: *Set) void {
+        s.arena.deinit();
+    }
+
+    pub fn of(s: *const Set, layer: u32) ?[]const u32 {
+        return s.layers.get(layer);
+    }
+};
+
+/// A prepared file mapped read-only, its pages asked for ahead.
+pub const Mapping = struct {
+    bytes: []align(std.heap.page_size_min) const u8,
+
+    pub fn open(io: std.Io, path: []const u8) !Mapping {
+        const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+        defer file.close(io);
+        const len: usize = @intCast(try file.length(io));
+        const bytes = try std.posix.mmap(null, len, .{ .READ = true }, .{ .TYPE = .SHARED }, file.handle, 0);
+        std.posix.madvise(bytes.ptr, bytes.len, std.posix.MADV.WILLNEED) catch {};
+        return .{ .bytes = bytes };
+    }
+
+    pub fn base(m: *const Mapping) u64 {
+        return @intFromPtr(m.bytes.ptr);
+    }
+
+    pub fn close(m: *Mapping) void {
+        std.posix.munmap(m.bytes);
+    }
+};
+
+/// One layer's cold experts, where its prepared file is mapped and each tensor's payload sits in it.
+pub const Layer = struct {
+    ids: []const u32,
+    layouts: [3]*const exl3.Layout,
+    base: u64,
+    offsets: *const std.StringHashMapUnmanaged(u64),
+
+    /// The layout of the routed projection `name` holds ("L3.moe.w2.data" / ".trellis"), else null.
+    pub fn layout(c: *const Layer, name: []const u8) ?*const exl3.Layout {
+        if (!std.mem.endsWith(u8, name, ".data") and !std.mem.endsWith(u8, name, ".trellis")) return null;
+        const at = std.mem.indexOf(u8, name, ".moe.w") orelse return null;
+        return switch (name[at + ".moe.w".len]) {
+            '1' => c.layouts[0],
+            '2' => c.layouts[1],
+            '3' => c.layouts[2],
+            else => null,
+        };
+    }
+};
+
+/// Expert `e`'s trellis bytes in a projection's buffer.
+pub fn expertBytes(lay: *const exl3.Layout, e: usize) usize {
+    const end = if (e + 1 < lay.count()) lay.offsets[e + 1] else lay.elements;
+    return @intCast(2 * (end - lay.offsets[e]));
+}
+
+/// The GPU must read pageable host memory through the host's page tables (GB10, Grace); anything else refuses the set.
+pub fn check(ctx: *const cuda.Context) !void {
+    if (try ctx.attribute(.pageable_memory_access) == 0) return error.NoPageableMemoryAccess;
+    if (try ctx.attribute(.pageable_memory_access_uses_host_page_tables) == 0) return error.NoPageableMemoryAccess;
+}
+
+test "a cold set parses the vLLM recipe's layer map" {
+    var s: Set = .{ .arena = .init(std.testing.allocator) };
+    defer s.deinit();
+    try s.parse(s.arena.allocator(), "{\"layers.0\": [6, 7], \"layers.39\": []}");
+    try std.testing.expectEqualSlices(u32, &.{ 6, 7 }, s.of(0).?);
+    try std.testing.expectEqual(@as(usize, 0), s.of(39).?.len);
+    try std.testing.expect(s.of(1) == null);
+    try std.testing.expectError(error.BadColdSet, s.parse(s.arena.allocator(), "{\"experts.0\": [1]}"));
+}
+
+test "a routed projection's name picks its layout" {
+    var lays: [3]exl3.Layout = undefined;
+    const offsets: std.StringHashMapUnmanaged(u64) = .empty;
+    const c: Layer = .{ .ids = &.{}, .layouts = .{ &lays[0], &lays[1], &lays[2] }, .base = 0, .offsets = &offsets };
+    try std.testing.expect(c.layout("L3.moe.w2.data") == &lays[1]);
+    try std.testing.expect(c.layout("L3.moe.w3.trellis") == &lays[2]);
+    try std.testing.expect(c.layout("L3.moe.w1.suh") == null);
+    try std.testing.expect(c.layout("L3.moe.shared.0.w1.trellis") == null);
+}
