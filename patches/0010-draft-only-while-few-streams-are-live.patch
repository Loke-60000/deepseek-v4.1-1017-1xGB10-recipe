@@ -26,8 +26,17 @@ pub const Options = struct {
     dup: tree.Dup = .{}, // tree.plan's sibling pricing (Python's: TF_DSV41_TREE_DUP_MS a sibling, its pending row counted)
     slots: u32 = 4, // streams at once
     spec: spec_mod.Settings = .{}, // the speculative pass (TF_DSV41_SPEC_DRAFT / _SPEC_NUCLEUS)
+    max_live: u32 = std.math.maxInt(u32), // TF_DSV41_SLOT_DRAFT_MAX_LIVE: more streams than this draft nothing
 };
 
+/// TF_DSV41_SLOT_DRAFT_MAX_LIVE=N: with more than N streams held, rounds propose no drafts (each stream verifies its
+/// pending row alone) while the drafter still ingests every committed row, so drafting resumes in context. Unset: no
+/// cap. One stream drafting costs a few experts a step; several verifying their drafts together touch many more.
+pub fn maxLiveFromEnv() !u32 {
+    const v = std.c.getenv("TF_DSV41_SLOT_DRAFT_MAX_LIVE") orelse return std.math.maxInt(u32);
+    return std.fmt.parseInt(u32, std.mem.span(v), 10);
+}
