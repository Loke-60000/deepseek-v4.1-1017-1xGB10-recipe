+/// The fixtures hold a TP=2 rank's o groups; at TP=1 the one rank holds all of them, group g + half as wide as group g.
+fn singleRankGroups(a: std.mem.Allocator, w: *block.Widths, cfg: *const Config) !void {
+    const half = cfg.o_groups / 2;
+    var added: std.ArrayList(struct { []const u8, u32 }) = .empty;
+    var it = w.dense.iterator();
+    while (it.next()) |e| {
+        const at = std.mem.indexOf(u8, e.key_ptr.*, ".attn.wo_a.") orelse continue;
+        const g = std.fmt.parseInt(u32, e.key_ptr.*[at + ".attn.wo_a.".len ..], 10) catch continue;
+        if (g >= half) continue;
+        try added.append(a, .{ try std.fmt.allocPrint(a, "{s}.attn.wo_a.{d}", .{ e.key_ptr.*[0..at], g + half }), e.value_ptr.* });
+    }
+    for (added.items) |x| try w.dense.put(a, x[0], x[1]);
+}
