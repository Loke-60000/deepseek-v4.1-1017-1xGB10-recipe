+/// The index row blocks' positions ("L.ix.pos<j>", int32) a 4K segment can name: their count peaks at a middle start
+/// (it grows with the keys until the stream path takes over), which neither planned end reaches. A block holds 16 rows
+/// at least (block_prefill step).
+fn k4BlockPositions(wp: *buffers.Plan) !void {
+    var nb: [32]u8 = undefined;
+    for (0..K4.rows / 16) |j| {
+        const role = try block_prefill.ownRole(wp.a, try std.fmt.bufPrint(&nb, "L.ix.pos{d}", .{j}), K4.tag);
+        const g = try wp.sizes.getOrPut(wp.a, role);
+        if (g.found_existing) wp.a.free(role) else g.value_ptr.* = 4;
+    }
+}
