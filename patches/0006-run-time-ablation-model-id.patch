+++ b/zig/kernels/cuda/deepseek_v41/glue.cu
@@ -11,6 +11,8 @@
 //   kit_logits   x = f32(bf16_rn(x)) in place                                         (pick.kit_logits)
 //   positions    pos[0] = start; pos64[i] = start + i; lo[i] = 0                       (Win.make)
 //   positions_dev  the same from a device start (a graphed window: staged before each replay)
+//   ablate       y[r] -= mask[r] Q^T (A (Q y[r])) over bf16 rows (TF_DSV41_ABLATE: an abliteration's writer edit
+//                at run time; Q [k, D], A [k, k] f32, k <= 8); rows with mask 0 keep their bytes
 //   expert_hits  hits[pick[i]] += 1 for each routed id in [0, E): TF_DSV41_HITS' routing counts (pruned / shared ids skipped)
 //   widen_f32    y = f32(x) of bf16 x                                                (q.float(): exact, the DSpark pass)
 //   gather_cols  out[i][w c + j] = recv[w][i][j]                                      (permute(1, 0, 2).reshape)
@@ -448,4 +450,45 @@ __global__ void __launch_bounds__(256) expert_hits_kernel(const int* __restrict_
     }
 }
 
+constexpr int ABLATE_MAX_K = 8;
+
+__global__ void __launch_bounds__(256) ablate_kernel(uint16_t* __restrict__ y, int D, const float* __restrict__ Q,
+                                                     const float* __restrict__ A, int k, const float* __restrict__ mask) {
+    const float m = mask[blockIdx.x];
+    if (m == 0.f) return;
+    uint16_t* row = y + (size_t)blockIdx.x * D;
+    __shared__ float part[8][ABLATE_MAX_K];
+    __shared__ float c[ABLATE_MAX_K];
+    float acc[ABLATE_MAX_K] = {};
+    for (int j = threadIdx.x; j < D; j += blockDim.x) {
+        const float v = bf(row[j]);
+#pragma unroll
+        for (int i = 0; i < ABLATE_MAX_K; ++i)
+            if (i < k) acc[i] += Q[(size_t)i * D + j] * v;
+    }
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+#pragma unroll
+    for (int i = 0; i < ABLATE_MAX_K; ++i) {
+        for (int o = 16; o > 0; o >>= 1) acc[i] += __shfl_xor_sync(0xffffffffu, acc[i], o);
+        if (lane == 0) part[warp][i] = acc[i];
+    }
+    __syncthreads();
+    if (threadIdx.x < k) {
+        float p[ABLATE_MAX_K];
+        for (int i = 0; i < k; ++i) {
+            p[i] = 0.f;
+            for (int w = 0; w < (int)(blockDim.x >> 5); ++w) p[i] += part[w][i];
+        }
+        float out = 0.f;
+        for (int j = 0; j < k; ++j) out += A[threadIdx.x * k + j] * p[j];
+        c[threadIdx.x] = m * out;
+    }
+    __syncthreads();
+    for (int j = threadIdx.x; j < D; j += blockDim.x) {
+        float v = bf(row[j]);
+        for (int i = 0; i < k; ++i) v -= Q[(size_t)i * D + j] * c[i];
+        row[j] = to_bf(v);
+    }
+}
+
 }  // namespace dsv41_glue
