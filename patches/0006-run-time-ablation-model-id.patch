diff --git a/zig/src/families/deepseek_v41/ablate.zig b/zig/src/families/deepseek_v41/ablate.zig
new file mode 100644
index 0000000..e7f79a7
--- /dev/null
+++ b/zig/src/families/deepseek_v41/ablate.zig
@@ -0,0 +1,130 @@
+//! TF_DSV41_ABLATE=<safetensors>: an abliteration applied at run time to the requests naming TENSORFOLD_ABLATE_MODEL.
+//! The file (the recipe's extract.py) holds `directions` f32 [L, k, D], `mix_attn` f32 [L, k, k] and `first_layer` i64
+//! [1]. From first_layer on, each layer's attention output (wo_b) rows subtract mask[row] Q_L^T (A_L (Q_L y)): the
+//! writer edit W' = W - Q A Q^T W done on its output. Rows whose mask is 0 keep their bytes, so the other requests in a
+//! batch are untouched. TF_DSV41_ABLATE_SCALE multiplies every A (tuning runs).
+
+const std = @import("std");
+const cuda = @import("cuda");
+
+pub const max_k = 8;
+/// rows the mask covers: a PF_4K segment and every decode bucket
+pub const mask_rows = 8192;
+
+pub const Ablation = struct {
+    k: u32,
+    D: u32,
+    layers: u32,
+    first_layer: u32,
+    dirs: cuda.DeviceBuffer,
+    mix: cuda.DeviceBuffer,
+    mask: cuda.DeviceBuffer,
+    d: *const cuda.Driver,
+
+    /// The abliteration TF_DSV41_ABLATE names, or null when unset.
+    pub fn fromEnv(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, D: u32) !?*Ablation {
+        const path = std.mem.trim(u8, std.mem.span(std.c.getenv("TF_DSV41_ABLATE") orelse return null), " ");
+        if (path.len == 0) return null;
+        var arena = std.heap.ArenaAllocator.init(gpa);
+        defer arena.deinit();
+        const a = arena.allocator();
+        const file = try File.parse(a, try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 30)));
+        const dirs = try file.tensor("directions", 3);
+        const mix = try file.tensor("mix_attn", 3);
+        const first = try file.tensor("first_layer", 1);
+        const L = dirs.shape[0];
+        const k = dirs.shape[1];
+        if (dirs.shape[2] != D or k == 0 or k > max_k) return error.BadAblation;
+        if (mix.shape[0] != L or mix.shape[1] != k or mix.shape[2] != k) return error.BadAblation;
+        const scale: f32 = if (std.c.getenv("TF_DSV41_ABLATE_SCALE")) |v| try std.fmt.parseFloat(f32, std.mem.span(v)) else 1;
+        const scaled = try a.dupe(u8, mix.bytes);
+        for (std.mem.bytesAsSlice(f32, @as([]align(1) u8, scaled))) |*x| x.* *= scale;
+        const ab = try gpa.create(Ablation);
+        errdefer gpa.destroy(ab);
+        ab.* = .{
+            .k = @intCast(k),
+            .D = D,
+            .layers = @intCast(L),
+            .first_layer = @intCast(std.mem.readInt(i64, first.bytes[0..8], .little)),
+            .dirs = try cuda.DeviceBuffer.fromHost(d, dirs.bytes),
+            .mix = try cuda.DeviceBuffer.fromHost(d, scaled),
+            .mask = try cuda.DeviceBuffer.alloc(d, mask_rows * 4),
+            .d = d,
+        };
+        try ab.mask.fill8(0, null);
+        std.log.info("dsv41 ablate: {s}: {d} directions a layer, layers {d}-{d}, scale {d}", .{ path, k, ab.first_layer, L - 1, scale });
+        return ab;
+    }
+
+    pub fn deinit(ab: *Ablation, gpa: std.mem.Allocator) void {
+        ab.dirs.free();
+        ab.mix.free();
+        ab.mask.free();
+        gpa.destroy(ab);
+    }
+
+    pub fn applies(ab: *const Ablation, layer: u32) bool {
+        return layer >= ab.first_layer and layer < ab.layers;
+    }
+
+    /// Mask rows [row0, row0 + n) on (1.0) or off (0.0), in order on `stream` before the launches that read them.
+    pub fn mark(ab: *const Ablation, stream: cuda.Stream, row0: usize, n: usize, on: bool) !void {
+        if (row0 + n > mask_rows) return error.AblateRows;
+        if (n == 0) return;
+        const bits: c_uint = if (on) @bitCast(@as(f32, 1)) else 0;
+        try ab.d.check(ab.d.api.cuMemsetD32Async(ab.mask.ptr + row0 * 4, bits, n, stream.handle), "cuMemsetD32Async");
+    }
+
+    /// Every row of the mask on or off (a one-slot window or segment: padding rows follow the slot).
+    pub fn markAll(ab: *const Ablation, stream: cuda.Stream, on: bool) !void {
+        return ab.mark(stream, 0, mask_rows, on);
+    }
+};
+
+/// A safetensors image's F32 / I64 tensors by name.
+const File = struct {
+    map: std.json.ObjectMap,
+    data: []const u8,
+
+    const Tensor = struct { shape: [4]usize, bytes: []const u8 };
+
+    fn parse(a: std.mem.Allocator, image: []const u8) !File {
+        if (image.len < 8) return error.BadAblation;
+        const n: usize = @intCast(std.mem.readInt(u64, image[0..8], .little));
+        if (8 + n > image.len) return error.BadAblation;
+        const root = try std.json.parseFromSliceLeaky(std.json.Value, a, image[8 .. 8 + n], .{});
+        if (root != .object) return error.BadAblation;
+        return .{ .map = root.object, .data = image[8 + n ..] };
+    }
+
+    fn tensor(f: *const File, name: []const u8, rank: usize) !Tensor {
+        const v = f.map.get(name) orelse return error.BadAblation;
+        if (v != .object) return error.BadAblation;
+        const shape = v.object.get("shape") orelse return error.BadAblation;
+        const offs = v.object.get("data_offsets") orelse return error.BadAblation;
+        if (shape != .array or shape.array.items.len != rank or offs != .array or offs.array.items.len != 2) return error.BadAblation;
+        var t: Tensor = .{ .shape = @splat(1), .bytes = &.{} };
+        for (shape.array.items, 0..) |s, i| t.shape[i] = @intCast(s.integer);
+        const lo: usize = @intCast(offs.array.items[0].integer);
+        const hi: usize = @intCast(offs.array.items[1].integer);
+        if (lo > hi or hi > f.data.len) return error.BadAblation;
+        t.bytes = f.data[lo..hi];
+        return t;
+    }
+};
+
+test "an ablation file's tensors parse by name and shape" {
+    const a = std.testing.allocator;
+    var arena = std.heap.ArenaAllocator.init(a);
+    defer arena.deinit();
+    const header = "{\"first_layer\":{\"dtype\":\"I64\",\"shape\":[1],\"data_offsets\":[0,8]}}";
+    var image: [8 + header.len + 8]u8 = undefined;
+    std.mem.writeInt(u64, image[0..8], header.len, .little);
+    @memcpy(image[8 .. 8 + header.len], header);
+    std.mem.writeInt(i64, image[8 + header.len ..][0..8], 14, .little);
+    const f = try File.parse(arena.allocator(), &image);
+    const t = try f.tensor("first_layer", 1);
+    try std.testing.expectEqual(@as(i64, 14), std.mem.readInt(i64, t.bytes[0..8], .little));
+    try std.testing.expectError(error.BadAblation, f.tensor("first_layer", 2));
+    try std.testing.expectError(error.BadAblation, f.tensor("directions", 3));
+}
